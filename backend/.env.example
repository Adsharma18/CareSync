# ==============================================================================
# CareSync Environment Configuration Template
# Copy this file to '.env' and populate with local/production values.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-to-a-cryptographically-secure-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL Database Configuration
DB_NAME=caresync_db
DB_USER=caresync_user
DB_PASSWORD=SecurePostgresPassword123!
DB_HOST=localhost
DB_PORT=5432

# SimpleJWT Settings (Minutes for Access, Days for Refresh)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Configuration (Allowed Frontend Origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
