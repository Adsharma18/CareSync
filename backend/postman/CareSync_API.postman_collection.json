      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Register User A (Coordinator A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains user id and email', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json.email).to.eql('sarah.jenkins@clinic.org');",
                  "    pm.expect(json).to.not.have.property('password');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Dr. Sarah Jenkins\",\n  \"email\": \"sarah.jenkins@clinic.org\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
